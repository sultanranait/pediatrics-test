span.kb-tooltip-hidden-content {
    display: block !important;
    position: absolute;
    min-width: 250px !important;
    background: #100B47 !important;
    padding: 10px 15px !important;
    border-radius: 10px !important;
    font-size: 12px !important;
    left: 0% !important;
    top: calc(100% + 11px) !important;
    transform: translate(-50%, 20px) !important;
    z-index: 99999999999999 !important;
    color: #fff !important;
    box-shadow: 0px 10px 20px -11px #100B47 !important;
    transition: all 0.3s ease !important;
    opacity: 0 !important;
}
figure.wp-block-kadence-image:has( span.kb-tooltip-hidden-content) {
    position: relative !important;
    z-index: 99999999 !important;
}
.kb-row-layout-wrap.wp-block-kadence-rowlayout:has( span.kb-tooltip-hidden-content) {
/*     z-index: 99999999 !important; */
}
span.kb-tooltip-hidden-content a {
    display: block !important;
    color: #DD91FF !important;
    text-decoration: none !important;
    margin: 10px 0 0 0 !important;
    font-weight: 600 !important;
}
span.kb-tooltip-hidden-content:before {
    content: '';
    position: absolute !important;
    top: 0 !important;
    left: 50% !important;
    transform: translate(-50%, calc(-100% - -1px)) !important;
    background: #100B47 !important;
    width: 30px !important;
    height: 13px !important;
    clip-path: polygon(50% 0%, 0% 100%, 100% 100%) !important;
    z-index: -1 !important;
}
figure.wp-block-kadence-image:has( span.kb-tooltip-hidden-content):hover span.kb-tooltip-hidden-content{
    transform:translate(-50%, 0px) !important;
    opacity:1 !important;
}
