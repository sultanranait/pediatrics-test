        min-height: 25px !important;
        transition: all 0.25s ease !important;
        outline: none !important;
    }
    .ginput_container.ginput_container_radio .gchoice:hover input {
        box-shadow: inset 0 0 0 12px #e9d3f57d !important;
    }
    .ginput_container.ginput_container_radio .gchoice input:checked {
        box-shadow: inset 0 0 0 12px #11AC65 !important;
    }
